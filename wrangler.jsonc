{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corralonprogreso",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-07-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/pedidos/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
